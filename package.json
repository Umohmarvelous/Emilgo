{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package && node scripts/dedupe-zod-validation-error.mjs",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5001 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "start": "npx expo start",
    "expo:remote": "node scripts/start-remote.js",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "game:dev": "npm --prefix games/emilgo-games run dev",
    "game:build": "npm --prefix games/emilgo-games run build",
    "game:embed": "npm --prefix games/emilgo-games run build:emilgo",
    "game:preview": "npm --prefix games/emilgo-games run preview",
    "game:sim": "tsx games/emilgo-games/scripts/sim.ts",
    "ls": "tree -I 'node_modules|.git|.env|.expo|dist|build|.config|.agents|.cursor|.vscode'",
    "ios:16": "npx expo start --ios --device 'iPhone 16 Pro'"
  },
