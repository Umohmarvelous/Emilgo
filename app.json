{
  "expo": {
    "name": "EMILGO",
    "slug": "teqil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "",
    "scheme": "teqil",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/emilgo_logo_green.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teqil.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Teqil uses Face ID to sign you in quickly and securely.",
        "NSLocationWhenInUseUsageDescription": "Teqil needs your location to track trips and show your position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Teqil needs your location to track trips in the background.",
        "NSCameraUsageDescription": "Teqil needs camera access to take your profile photo and to send photos in a chat.",
        "NSPhotoLibraryUsageDescription": "Teqil needs photo library access to set your profile photo, send photos in a chat and choose a chat wallpaper.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "whatsapp"
        ],
        "NSMicrophoneUsageDescription": "Teqil needs microphone access to record voice messages in a chat."
      }
    },
    "android": {
      "package": "com.teqil.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/images/emilgo_logo_green.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-location",
      "expo-image-picker",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-audio",
      "expo-asset",
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This lets EMILGO show you ads that are more relevant, which pays more into your fuel pool."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets EMILGO show you ads that are more relevant, which pays more into your fuel pool."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "492934f4-8a6b-45de-9399-4d6687854411"
      }
    },
    "owner": "stainles",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/492934f4-8a6b-45de-9399-4d6687854411"
    }
  }
}
