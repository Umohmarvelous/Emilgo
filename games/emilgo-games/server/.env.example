# Copy to server/.env (git-ignored) and fill in. Never commit the real file.
# Keys: Lagos Life developer dashboard → your game → Keys. Test keys start
# vtr_test_…; live keys (after approval) vtr_live_… — the prefix sets the mode.
VATAR_SECRET=vtr_test_...
VATAR_WEBHOOK_SECRET=vtr_whsec_...
VATAR_RESULTS_SECRET=vtr_rsec_...

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TICKET_SECRET=
ADMIN_TOKEN=

DATA_DIR=/data
# Where the game is served from (Origin headers allowed to connect).
GAMES_ORIGINS=https://emilgo.pages.dev,https://games.emilgo.local
# Set to 1 only behind the Cloudflare tunnel (reads CF-Connecting-IP).
# TRUST_PROXY=1

# Rank for EMILGO app players (SPEC-V3): the app's Supabase project. Either
# its URL (public signing keys) or, for HS256 projects, its JWT secret.
# Unset: EMILGO players play unranked (their phone keeps its own count).
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# This week's modes (SPEC-V3 §1.3): a manifest file and the Ed25519 key that
# signs it (see server/src/content.ts). Unset: the built-in manifest only.
CONTENT_FILE=
CONTENT_SIGNING_KEY=
